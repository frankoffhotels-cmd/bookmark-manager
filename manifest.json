{
  "manifest_version": 3,
  "name": "Bookmark Manager",
  "version": "1.0.0",
  "description": "Управляйте закладками Chrome с помощью тегов и поиска.",
  "permissions": ["bookmarks", "storage"],
  "action": {
    "default_title": "Менеджер закладок",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
